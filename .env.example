# Example variable names with safe sample values only. Never put real secrets in this file.
# Copy to .env for local development. .env is git-ignored.

# --- Backend (server-side only) ---
NODE_ENV=development
PORT=4000
APP_VERSION=0.1.0
# Comma-separated exact origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:3000

# Runtime connection to PostgreSQL. Neon: use the pooled connection string from the Neon console.
# Leave unset until the owner provides credentials; the API then reports the database as NOT_CONFIGURED.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/property_platform

# Non-pooled connection used only for Prisma migrations (Neon recommends a direct connection
# for schema changes). Falls back to DATABASE_URL when unset.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/property_platform

# --- Frontend (public; bundled into the browser, so NEVER place secrets here) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
