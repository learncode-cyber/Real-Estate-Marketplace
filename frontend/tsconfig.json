{
  "extends": "../packages/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "types": ["node", "vitest/globals"]
  },
  "include": ["next-env.d.ts", "src", "next.config.ts", "vitest.config.ts", "eslint.config.mjs"],
  "exclude": ["node_modules", ".next"]
}
