{
  "extends": "../packages/tsconfig/base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "jest"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "test", "jest.config.ts"]
}
